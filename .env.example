NEXT_PUBLIC_SITE_URL=https://open-claude-jet.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only 32-byte base64 key for AES-256-GCM encrypted application secrets.
APP_ENCRYPTION_KEY=
# Optional analytics measurement ID. Analytics must only run after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AI Router / OpenRouter. The API key must exist only in server-side secret storage.
# NEVER commit a real key here. NEVER expose OMNIROUTE_API_KEY to the browser.
OMNIROUTE_ENABLED=true
OMNIROUTE_BASE_URL=https://openrouter.ai/api/v1
OMNIROUTE_API_KEY=
AI_PROVIDER=omniroute
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b-20260604:free
AI_ROUTING_STRATEGY=free
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
