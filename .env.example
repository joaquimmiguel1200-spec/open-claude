NEXT_PUBLIC_SITE_URL=https://open-claude.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only 32-byte base64 key for AES-256-GCM encrypted application secrets.
APP_ENCRYPTION_KEY=
# Optional analytics measurement ID. Analytics must only run after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AI Router: use OmniRoute as the gateway when configured.
OMNIROUTE_ENABLED=true
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
AI_PROVIDER=omniroute
AI_MODEL=auto
AI_ROUTING_STRATEGY=auto
